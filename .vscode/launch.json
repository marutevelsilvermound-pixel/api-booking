{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: api-booking",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "cwd": "${workspaceFolder}",
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_DEBUG": "0"
      },
      "args": [
        "run",
        "--no-debugger",
        "--no-reload",
        "--port",
        "5000"
      ],
      "jinja": true,
      "console": "internalConsole"
    }
  ]
}